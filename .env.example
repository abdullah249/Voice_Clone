# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API Key (get from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (optional, default: cjVigY5qzO86Huf0OWal)
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal

# OpenAI API Key (optional, if using OpenAI as LLM)
# OPENAI_API_KEY=your_openai_api_key_here
